# Environment Configuration - copy to .env and fill in values
# Never commit .env to version control

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=pepoltek.settings.dev
SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://pepoltek:pepoltek@localhost:5432/pepoltek_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── S3 / MinIO ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=pepoltek-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
ANYMAIL_ESP_NAME=mailpit

# ─── AI Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-change-me
ANTHROPIC_API_KEY=sk-ant-change-me
AI_PROVIDER=openai

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ISR_REVALIDATE_SECRET=change-me-secret-token

# ─── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Field Encryption ─────────────────────────────────────────────────────────
FIELD_ENCRYPTION_KEY=change-me-32-char-fernet-key=====
